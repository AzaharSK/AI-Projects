# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional overrides (shown with defaults) ──────────────────────────────────
LLM_MODEL=openai:gpt-4o
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=6

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO

# URL that Streamlit uses to talk to FastAPI
BACKEND_URL=http://localhost:8000
