[Unit]
Description=Promtail Log Shipper
After=network-online.target loki.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/promtail --config.file=/etc/promtail/config.yaml
Restart=always
RestartSec=3
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
